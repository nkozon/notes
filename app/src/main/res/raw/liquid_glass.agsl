// Rounded glass lens using a signed-distance surface and Snell refraction.
// Independently implemented for the Compose/Haze backdrop pipeline.
uniform shader backdrop;
uniform float4 body;
uniform float4 corners; // top-left, top-right, bottom-right, bottom-left
uniform float2 textureSize;
uniform float edgeWidth;
uniform float strength;
uniform float refractionDepth;

float distanceToGlass(float2 point) {
    float2 local = point - body.xy - body.zw * 0.5;
    float corner = local.y < 0.0
        ? (local.x < 0.0 ? corners.x : corners.y)
        : (local.x < 0.0 ? corners.w : corners.z);
    float2 delta = abs(local) - body.zw * 0.5 + corner;
    return min(max(delta.x, delta.y), 0.0) + length(max(delta, 0.0)) - corner;
}

half4 main(float2 position) {
    float distance = distanceToGlass(position);
    // A bounded bevel leaves an inset contour on large glass panels. A Gaussian
    // falloff keeps the full edge depth and eases into the center without a band boundary.
    float inwardDistance = min(distance, 0.0) / max(edgeWidth, 1.0);
    float edge = exp(-0.5 * inwardDistance * inwardDistance);
    // Opposite sides of a pill have opposite normals. Average the slope over
    // a bevel-width neighborhood inside the lens so they meet smoothly at its
    // center. Keep the half-pixel derivative at the rim for a crisp highlight.
    float radius = max(0.5, min(-distance * 0.5, edgeWidth));
    float2 gradient = float2(
        distanceToGlass(position + float2(radius, 0.0)) - distanceToGlass(position - float2(radius, 0.0)),
        distanceToGlass(position + float2(0.0, radius)) - distanceToGlass(position - float2(0.0, radius))
    ) / (2.0 * radius);
    // Ease the averaged slope back to unit length where only one edge contributes.
    gradient *= 1.5 - 0.5 * min(dot(gradient, gradient), 1.0);
    float3 normal = normalize(float3(gradient * edge, sqrt(max(1.0 - edge * edge, 0.001))));
    // At a square corner the nearest edge switches along a diagonal. Blend the
    // two perpendicular bevels independently there so the sampled image stays smooth.
    float2 fromStart = (position - body.xy) / edgeWidth;
    float2 fromEnd = body.zw / edgeWidth - fromStart;
    float4 sides = float4(fromStart, fromEnd); // left, top, right, bottom
    float4 nearSide = 1.0 - smoothstep(2.0, 4.0, sides);
    float4 nearCorner = nearSide.xzzx * nearSide.yyww;
    float squareWeight = min(dot(nearCorner, 1.0 - step(float4(0.001), corners)), 1.0);
    if (squareWeight > 0.0) {
        float4 bevel = exp(-0.5 * sides * sides);
        float2 slope = bevel.zw - bevel.xy;
        float2 upright = max(1.0 - slope * slope, 0.001);
        float3 squareNormal = normalize(float3(slope, sqrt(upright.x * upright.y)));
        normal = normalize(mix(normal, squareNormal, squareWeight));
        gradient = mix(gradient, slope, squareWeight);
    }
    float3 ray = refract(float3(0.0, 0.0, -1.0), normal, 1.0 / 1.5);
    float2 displacement = ray.xy / max(-ray.z, 0.1) * edgeWidth * refractionDepth * strength;
    float2 samplePosition = clamp(position + displacement, float2(0.5), textureSize - 0.5);
    half4 glass = backdrop.eval(samplePosition);
    // A narrow, soft highlight follows the lens contour, lit gently from above-left.
    // Keep every edge faintly visible without turning it into a uniform white border.
    float rimWidth = max(edgeWidth * 0.075, 0.5);
    float rimDistance = (distance + rimWidth * 0.65) / rimWidth;
    float rim = exp(-0.5 * rimDistance * rimDistance);
    float2 outward = gradient / max(length(gradient), 0.001);
    float lightFacing = clamp(0.5 + 0.5 * dot(outward, float2(-0.6, -0.8)), 0.0, 1.0);
    half highlight = half(rim * (0.02 + 0.07 * lightFacing * lightFacing) * strength);
    glass.rgb += (half3(glass.a) - glass.rgb) * highlight;
    return glass;
}
